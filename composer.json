{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": ["laravel", "framework"],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "darkaonline/l5-swagger": "^11.0",
        "laravel/framework": "^13.0",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^3.0",
        "spatie/laravel-activitylog": "^5.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pail": "^1.2.5",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install --ignore-scripts",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1 --timeout=0\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@composer test:unitario",
            "@composer test:integracao"
        ],
        "test:unitario": [
            "@php artisan config:clear --ansi",
            "@php vendor/bin/phpunit --configuration=phpunit.unitario.xml --testsuite=Unitario"
        ],
        "test:integracao": [
            "@php artisan config:clear --ansi",
            "@php vendor/bin/phpunit --configuration=phpunit.integracao.xml --testsuite=Integracao"
        ],
        "test:coverage:unitario": [
            "@php artisan config:clear --ansi",
            "@php -d pcov.enabled=1 -d pcov.directory=app vendor/bin/phpunit --configuration=phpunit.unitario.xml --testsuite=Unitario --coverage-text"
        ],
        "test:coverage:unitario:php": [
            "@php artisan config:clear --ansi",
            "@php -r \"is_dir('build/coverage') || mkdir('build/coverage', 0777, true);\"",
            "@php -d pcov.enabled=1 -d pcov.directory=app vendor/bin/phpunit --configuration=phpunit.unitario.xml --testsuite=Unitario --coverage-php build/coverage/unitario.cov"
        ],
        "test:coverage:integracao": [
            "@php artisan config:clear --ansi",
            "@php -d pcov.enabled=1 -d pcov.directory=app vendor/bin/phpunit --configuration=phpunit.integracao.xml --testsuite=Integracao --coverage-text"
        ],
        "test:coverage:integracao:php": [
            "@php artisan config:clear --ansi",
            "@php -r \"is_dir('build/coverage') || mkdir('build/coverage', 0777, true);\"",
            "@php -d pcov.enabled=1 -d pcov.directory=app vendor/bin/phpunit --configuration=phpunit.integracao.xml --testsuite=Integracao --coverage-php build/coverage/integracao.cov"
        ],
        "test:coverage:merge": [
            "@php scripts/merge-coverage.php build/coverage/unitario.cov build/coverage/integracao.cov build/coverage/combined"
        ],
        "test:coverage:combined": [
            "@composer test:coverage:unitario:php",
            "@composer test:coverage:integracao:php",
            "@composer test:coverage:merge"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
