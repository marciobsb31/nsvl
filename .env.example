# ============================================================
# NVSL Backend — Variáveis de Ambiente
# Copie para .env e preencha com os valores reais
# NUNCA comite o .env real no repositório
# ============================================================

APP_NAME=NVSL
APP_ENV=local
APP_KEY=base64:PpIGWDxZgmG46nScinKZZAGsQYjp7OFiqdMr6PWPOiY=
APP_DEBUG=true
APP_TIMEZONE=America/Sao_Paulo
APP_URL=http://localhost:8081

# URL do frontend (Docker Compose: SPA na porta 80). Com Vite local, use http://localhost:5176.
FRONTEND_URL=http://localhost
GOVBR_FRONTEND_LOGIN_PATH=/callback

LOG_CHANNEL=stack
LOG_LEVEL=debug

# -------------------------------------------------------
# Banco de Dados
# -------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=nvsl
DB_USERNAME=nvsl_user
DB_PASSWORD=nvsl_password

# -------------------------------------------------------
# Cache / Sessão / Filas
# -------------------------------------------------------
CACHE_STORE=file
CACHE_PREFIX=nvsl_
SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_CONNECTION=sync

# -------------------------------------------------------
# Sanctum
# -------------------------------------------------------
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:80,localhost:5176,localhost:8081,127.0.0.1

# -------------------------------------------------------
# GOV.BR SSO OAuth2/OIDC (homologação: sso.staging.acesso.gov.br)
# Roteiro: https://acesso.gov.br/roteiro-tecnico
#
# URLs comuns no cadastro MGI (localhost):
#   - http://localhost:8081                    (origem / health da API)
#   - http://localhost:8081/api/auth/redirect  (redirect_uri OAuth)
#   - http://localhost:8081/logout             (GET — redireciona ao login do frontend; revogação: POST /api/auth/logout)
# Credenciais homologação: ver LOGIN-GOVBR-SETUP.md
# -------------------------------------------------------
GOVBR_CLIENT_ID=
GOVBR_CLIENT_SECRET=
# Deve coincidir com o redirect_uri cadastrado no MGI
GOVBR_REDIRECT_URI=http://localhost:8081/api/auth/redirect
GOVBR_SSO_URL=https://sso.staging.acesso.gov.br
GOVBR_SCOPES="openid email profile govbr_confiabilidades govbr_confiabilidades_idtoken"

# -------------------------------------------------------
# Swagger
# -------------------------------------------------------
L5_SWAGGER_GENERATE_ALWAYS=true
L5_SWAGGER_CONST_HOST=${APP_URL}
L5_SWAGGER_PROXY=true

# -------------------------------------------------------
# Seed de bootstrap
# Valores esperados: bootstrap | demo | test
# -------------------------------------------------------
DB_SEED_PROFILE=bootstrap
