# ==================================================
# Variáveis de Ambiente — NVSL Frontend
# Copie este arquivo para .env e preencha os valores
# NUNCA commite .env em repositórios públicos
# ==================================================

# -- Aplicação --
VITE_APP_NAME=${VITE_APP_NAME}
VITE_APP_ENV=${VITE_APP_ENV}
VITE_APP_VERSION=${VITE_APP_VERSION}

# -- GOV.BR SSO OAuth2/OIDC --
# Client ID registrado no portal GOV.BR
VITE_GOVBR_CLIENT_ID=${VITE_GOVBR_CLIENT_ID}

# URL de redirecionamento após login (deve ser registrada no GOV.BR)
VITE_GOVBR_REDIRECT_URI=${VITE_GOVBR_REDIRECT_URI}

# URL de redirecionamento após logout
VITE_GOVBR_POST_LOGOUT_REDIRECT_URI=${VITE_GOVBR_POST_LOGOUT_REDIRECT_URI}

# URL base do SSO GOV.BR (staging ou produção)
# Staging:    https://sso.staging.acesso.gov.br
# Produção:   https://sso.acesso.gov.br
VITE_GOVBR_SSO_URL=${VITE_GOVBR_SSO_URL}

# Escopos OIDC solicitados
VITE_GOVBR_SCOPES=${VITE_GOVBR_SCOPES}

# -- API Backend (se aplicável) --
VITE_API_BASE_URL=${VITE_API_BASE_URL}
