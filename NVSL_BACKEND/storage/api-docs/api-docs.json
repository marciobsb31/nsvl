{
    "openapi": "3.0.0",
    "info": {
        "title": "NVSL API",
        "description": "API do Sistema NVSL com autenticação GOV.BR e gestão de perfis.",
        "contact": {
            "email": "suporte@nvsl.gov.br"
        },
        "license": {
            "name": "Proprietário"
        },
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "{host}",
            "description": "Servidor configurado por ambiente",
            "variables": {
                "host": {
                    "default": "http://localhost:8081"
                }
            }
        }
    ],
    "paths": {
        "/api/auth/redirect": {
            "get": {
                "tags": [
                    "Autenticação"
                ],
                "summary": "Inicia login GOV.BR",
                "description": "Retorna a URL de autorização do SSO (PKCE + state em cache).",
                "operationId": "e89c5e66848b282e97d6ab1f0a627a06",
                "responses": {
                    "200": {
                        "description": "URL do SSO",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "url": {
                                            "type": "string",
                                            "format": "uri"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Configuração GOV.BR incompleta"
                    },
                    "429": {
                        "description": "Limite de requisições"
                    }
                }
            }
        },
        "/api/auth/callback": {
            "get": {
                "tags": [
                    "Autenticação"
                ],
                "summary": "Callback OAuth2 (alternativo ao /redirect-gov)",
                "description": "Mesmo fluxo do callback web: valida state/code, cria token Sanctum e redireciona ao frontend com fragmento.",
                "operationId": "4ba9ecb97f49f920628f8f07753eb9c1",
                "parameters": [
                    {
                        "name": "code",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "state",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "error",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    },
                    {
                        "name": "error_description",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "302": {
                        "description": "Redirecionamento para FRONTEND_URL/login#govbr_login_code=... ou govbr_error=..."
                    },
                    "429": {
                        "description": "Limite de requisições"
                    }
                }
            }
        },
        "/api/auth/exchange": {
            "post": {
                "tags": [
                    "Autenticação"
                ],
                "summary": "Troca código de login por token Sanctum",
                "description": "Envia o `govbr_login_code` recebido no fragmento da URL após o redirect do callback.",
                "operationId": "8fa9ac53571a6b7cb376b282b0537a5b",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "code"
                                ],
                                "properties": {
                                    "code": {
                                        "description": "Código descartável gerado após callback bem-sucedido",
                                        "type": "string"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Token e usuário seguro",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "token": {
                                            "type": "string"
                                        },
                                        "user": {
                                            "$ref": "#/components/schemas/UserResource"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Código inválido ou expirado"
                    },
                    "429": {
                        "description": "Limite de requisições"
                    }
                }
            }
        },
        "/api/auth/logout": {
            "post": {
                "tags": [
                    "Autenticação"
                ],
                "summary": "Encerra sessão Sanctum",
                "operationId": "e7a649c32cbc482b7375c03e417a92e3",
                "responses": {
                    "200": {
                        "description": "Logout realizado",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Logout realizado com sucesso."
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Não autenticado"
                    },
                    "429": {
                        "description": "Limite de requisições"
                    }
                },
                "security": [
                    {
                        "BearerAuth": []
                    }
                ]
            }
        },
        "/api/auth/token-de-teste": {
            "post": {
                "tags": [
                    "Autenticação"
                ],
                "summary": "Emite token Sanctum para usuário de teste",
                "description": "Disponível apenas com APP_ENV=local ou testing (desabilitado em produção).",
                "operationId": "87144eab9e2ba7da78310ff9ea6eaf1e",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "perfil": {
                                        "description": "Qual usuário fixture usar",
                                        "type": "string",
                                        "enum": [
                                            "federal",
                                            "estadual",
                                            "municipal"
                                        ]
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Token e usuário",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "token": {
                                            "type": "string"
                                        },
                                        "user": {
                                            "$ref": "#/components/schemas/UserResource"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "Ambiente não permitido"
                    },
                    "404": {
                        "description": "Usuário de teste não encontrado (execute seeders)"
                    },
                    "429": {
                        "description": "Limite de requisições"
                    }
                }
            }
        },
        "/api/user": {
            "get": {
                "tags": [
                    "Usuário"
                ],
                "summary": "Retorna os dados do usuário autenticado",
                "description": "Campos sensíveis são omitidos da resposta.",
                "operationId": "22a6f0a396f544b2567e620f838ed602",
                "responses": {
                    "200": {
                        "description": "Dados seguros do usuário",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/UserResource"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Não autenticado"
                    }
                },
                "security": [
                    {
                        "BearerAuth": []
                    }
                ]
            }
        },
