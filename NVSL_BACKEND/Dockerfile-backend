# ============================================================
# NVSL Backend — Dockerfile
# Build multi-stage: composer + PHP 8.3 FPM + Nginx + Supervisord
# ============================================================

# -------------------------------------------------------
# Stage 1: Build das dependências PHP (sem dev)
# -------------------------------------------------------
FROM composer:2 AS build

WORKDIR /app

# Corrige problema de SSL do composer
RUN apk add --no-cache \
    ca-certificates \
    git \
    unzip \
    && update-ca-certificates

COPY composer.json composer.lock* ./

RUN composer install \
    --no-dev \
    --no-scripts \
    --prefer-dist \
    --optimize-autoloader

COPY . .

# -------------------------------------------------------
# Stage 2: Runtime
# -------------------------------------------------------
FROM php:8.4-fpm-alpine

# Copia o composer
COPY --from=build /usr/bin/composer /usr/bin/composer

# Dependências do sistema
RUN apk add --no-cache \
    nginx \
    supervisor \
    libpng-dev \
    libzip-dev \
    oniguruma-dev \
    icu-dev \
    postgresql-dev \
    bash \
    curl

# Extensões PHP necessárias
RUN docker-php-ext-install \
    pdo \
    pdo_pgsql \
    mbstring \
    intl \
    zip \
    opcache \
    pcntl

WORKDIR /var/www/html

# Copia build do stage anterior
COPY --from=build /app /var/www/html

# Copia configs do Docker
COPY docker/nginx.conf      /etc/nginx/nginx.conf
COPY docker/supervisord.conf /etc/supervisord.conf
COPY docker/php.ini          /usr/local/etc/php/conf.d/php.ini
COPY docker/entrypoint.sh    /entrypoint.sh

# Corrige CRLF do entrypoint (Windows) e permissões
RUN sed -i 's/\r$//' /entrypoint.sh \
    && chmod +x /entrypoint.sh \
    && mkdir -p /var/www/html/storage/framework/views \
    /var/www/html/storage/framework/cache \
    /var/www/html/storage/framework/sessions \
    /var/www/html/storage/logs \
    /var/www/html/storage/app/public \
    /var/www/html/bootstrap/cache \
    /var/www/html/resources/views \
    && chown -R www-data:www-data /var/www/html \
    && chmod -R 775 /var/www/html/storage /var/www/html/bootstrap/cache \
    && mkdir -p /var/run/nginx /var/log/nginx /var/log/supervisor

EXPOSE 80

#HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
#   CMD curl -sf http://localhost:80/api/health | grep -q '"status":"ok"' || exit 1

ENTRYPOINT ["/entrypoint.sh"]
CMD ["/usr/bin/supervisord", "-c", "/etc/supervisord.conf"]
