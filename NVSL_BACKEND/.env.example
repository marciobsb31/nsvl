# ============================================================
# NVSL Backend — Variáveis de Ambiente
# Copie para .env e preencha com os valores reais
# NUNCA comite o .env real no repositório
# ============================================================

APP_NAME=NVSL
APP_ENV=local
APP_KEY=base64:PpIGWDxZgmG46nScinKZZAGsQYjp7OFiqdMr6PWPOiY=
APP_DEBUG=true
APP_TIMEZONE=America/Sao_Paulo
APP_URL=http://localhost:8081

# URL do frontend
FRONTEND_URL=http://localhost:5174

LOG_CHANNEL=stack
LOG_LEVEL=debug

# -------------------------------------------------------
# Banco de Dados
# -------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=nvsl
DB_USERNAME=nvsl_user
DB_PASSWORD=nvsl_password

# -------------------------------------------------------
# Cache / Sessão / Filas
# -------------------------------------------------------
CACHE_STORE=redis
CACHE_PREFIX=nvsl_
SESSION_DRIVER=redis
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# -------------------------------------------------------
# Sanctum
# -------------------------------------------------------
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:80,localhost:5174,localhost:8081,127.0.0.1

# -------------------------------------------------------
# GOV.BR SSO OAuth2/OIDC (homologação: sso.staging.acesso.gov.br)
# Roteiro: https://acesso.gov.br/roteiro-tecnico
# Para localhost: solicite ao MGI incluir http://localhost:8081/api/auth/callback
# Credenciais homologação: ver LOGIN-GOVBR-SETUP.md
# -------------------------------------------------------
GOVBR_CLIENT_ID=
GOVBR_CLIENT_SECRET=
# redirect_uri: localhost para testes | homologação: https://h-nvsl.dev.mdh.gov.br/api/auth/callback
GOVBR_REDIRECT_URI=http://localhost:8081/redirect-gov
GOVBR_SSO_URL=https://sso.staging.acesso.gov.br
GOVBR_SCOPES="openid email profile govbr_confiabilidades govbr_confiabilidades_idtoken"

# -------------------------------------------------------
# Swagger
# -------------------------------------------------------
L5_SWAGGER_GENERATE_ALWAYS=true
