                            "type": "string",
                            "enum": [
                                "federal",
                                "estadual",
                                "municipal"
                            ]
                        }
                    },
                    {
                        "name": "status",
                        "in": "query",
                        "schema": {
                            "type": "string",
                            "enum": [
                                "em_analise",
                                "aprovado",
                                "reprovado"
