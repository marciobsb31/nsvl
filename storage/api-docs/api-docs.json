        "/api/health": {
            "get": {
                "tags": [
                    "Sistema"
                ],
                "summary": "Verifica a saúde da aplicação",
                "description": "Retorna status do banco de dados e cache. Útil para healthchecks de orquestração (Docker, Kubernetes).",
                "operationId": "7134f626524ee8957bd6315b959ed4e1",
                "responses": {
                    "200": {
                        "description": "Aplicação saudável",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "status": {
                                            "type": "string",
                                            "example": "ok"
                                        },
                                        "database": {
                                            "type": "string",
                                            "example": "ok"
                                        },
                                        "cache": {
                                            "type": "string",
                                            "example": "ok"
                                        },
                                        "version": {
                                            "type": "string",
                                            "example": "1.0.0"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "503": {
                        "description": "Serviço indisponível"
                    }
                }
            }
        },
