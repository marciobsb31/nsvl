# ============================================================
# Stage 1: Build
# Base: node:20-alpine (imagem leve e segura)
# ============================================================
FROM node:20-alpine AS build

# Define diretório de trabalho
WORKDIR /app

# Build args para variáveis Vite (API URL relativa = proxy no nginx)
ARG VITE_API_BASE_URL=/api
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL

# Copia arquivos de dependência primeiro (cache de camadas)
COPY package*.json ./

# Instala dependências com CI (reproducível, mais seguro)
RUN npm ci --prefer-offline

# Copia o restante do código-fonte
COPY . .

# Executa o build de produção
RUN npm run build

# ============================================================
# Stage 2: Serve com Nginx
# Base: nginx:stable-alpine (imagem minimalista e segura)
# ============================================================
FROM nginx:stable-alpine AS serve

# Remove configuração padrão do Nginx
RUN rm /etc/nginx/conf.d/default.conf

# Copia configuração customizada do Nginx
COPY nginx.conf /etc/nginx/conf.d/app.conf

# Copia os arquivos de build gerados pelo Stage 1
COPY --from=build /app/dist /usr/share/nginx/html

# Expõe a porta HTTP
EXPOSE 80

# Healthcheck para orquestração
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- http://localhost/index.html || exit 1

# Inicia o Nginx em foreground (não daemon)
CMD ["nginx", "-g", "daemon off;"]
